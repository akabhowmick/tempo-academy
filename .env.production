# Production build settings, committed so a plain git deploy has them.
# A variable set in Netlify's environment overrides the value here.

# FormSubmit endpoint for the contact form (see .env.example). The inbox
# address is enough to activate it; it's already public on every page.
# After activation you can swap in FormSubmit's random-string ID.
VITE_FORMSUBMIT_ID=contacttempoacademy@gmail.com

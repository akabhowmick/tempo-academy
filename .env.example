# Copy to .env.local for local dev (gitignored), or set in Netlify's
# Site settings -> Environment variables for production builds.

# Formspree form id, e.g. "abcdwxyz" from https://formspree.io/f/abcdwxyz.
# Until this is set, the contact form on /contact is disabled and shows a
# phone/email fallback instead of posting to a dead endpoint.
VITE_FORMSPREE_ID=
